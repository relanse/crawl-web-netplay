# Track the multiplayer source overlay on top of the local game project.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/mirror-dependency.json
!/run-netplay-build.ps1
!/start-network.ps1
!/audit-netplay.mjs
!/本机试玩.cmd
!/停止联机.cmd

!/server/
/server/*
!/server/.gitignore
!/server/package.json
!/server/package-lock.json
!/server/*.mjs
!/server/online/
!/server/test/
/server/online/*
!/server/online/*.html
!/server/online/*.js
!/server/online/*.css
/server/test/*
!/server/test/*.mjs

# Legacy stream policy remains covered by the shared Node test suite.
!/site/
/site/*
!/site/*.html
!/site/*.js
!/site/*.css

!/web-project/
/web-project/*
!/web-project/Assets/
!/web-project/Packages/
!/web-project/ProjectSettings/
/web-project/Packages/*
!/web-project/Packages/manifest.json
!/web-project/Packages/packages-lock.json
/web-project/ProjectSettings/*
!/web-project/ProjectSettings/ProjectVersion.txt
/web-project/Assets/*
!/web-project/Assets/Editor/
!/web-project/Assets/Editor.meta
!/web-project/Assets/Plugins/
!/web-project/Assets/Scripts/
/web-project/Assets/Editor/*
!/web-project/Assets/Editor/Crawl*.cs
!/web-project/Assets/Editor/Crawl*.cs.meta
/web-project/Assets/Plugins/*
!/web-project/Assets/Plugins/WebGL/
!/web-project/Assets/Plugins/WebGL.meta
/web-project/Assets/Plugins/WebGL/*
!/web-project/Assets/Plugins/WebGL/Crawl*.jslib
!/web-project/Assets/Plugins/WebGL/Crawl*.jslib.meta
/web-project/Assets/Scripts/*
!/web-project/Assets/Scripts/Assembly-CSharp/
/web-project/Assets/Scripts/Assembly-CSharp/*
!/web-project/Assets/Scripts/Assembly-CSharp/Netplay/
!/web-project/Assets/Scripts/Assembly-CSharp/Netplay.meta
!/web-project/Assets/Scripts/Assembly-CSharp/CrawlRemoteInput.cs
!/web-project/Assets/Scripts/Assembly-CSharp/CrawlRemoteInput.cs.meta
!/web-project/Assets/Scripts/Assembly-CSharp/CrawlWebLobby.cs
!/web-project/Assets/Scripts/Assembly-CSharp/CrawlWebLobby.cs.meta
/web-project/Assets/Scripts/Assembly-CSharp/Netplay/*
!/web-project/Assets/Scripts/Assembly-CSharp/Netplay/*.cs
!/web-project/Assets/Scripts/Assembly-CSharp/Netplay/*.cs.meta

# Block secrets and generated files even within the allowed source directories.
.env
.env.*
*.pem
*.pfx
*.key
*.sqlite*
*.sav
*.log
*.zip
node_modules/
online-data/
test-results/
